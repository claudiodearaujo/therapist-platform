# Dedicated Coolify stack for therapist-platform using Supabase managed PostgreSQL.
# Copy these keys into the Coolify environment. Never commit real secrets.

APP_PORT=18080

# Supabase PostgreSQL connection used by Prisma.
# Prefer the direct connection for migrations/long-lived backends when the host has IPv6.
# On IPv4-only hosts, use the Supavisor session-pooler connection from Supabase Connect.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres

JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Browser session mutations validate Origin even when Nginx proxies /api same-origin.
# Keep this allowlist explicit; add the exact Tailscale HTTPS origin when that URL is used.
FRONTEND_URL=http://localhost:18080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
# Set to the dedicated Coolify/Docker network CIDR used by the stack.
TRUST_PROXY_CIDRS=10.0.3.0/24
BACKEND_URL=http://localhost:18080

# Supabase project API and Storage credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_PRIVATE_STORAGE_BUCKET=therapist-private
SUPABASE_STORAGE_BUCKET=therapist-platform

STRIPE_SECRET_KEY=sk_test_local_placeholder
STRIPE_WEBHOOK_SECRET=whsec_local_placeholder

# Optional. When empty, raw IPs are not persisted or fingerprinted in audit events.
AUDIT_IP_HASH_SALT=

# SaaS subscription billing is intentionally off until provider credentials are configured.
SAAS_BILLING_ENABLED=false
SAAS_PROFESSIONAL_PRICE_ID=
SAAS_PROFESSIONAL_MONTHLY_PRICE_CENTS=
SAAS_STUDIO_PRICE_ID=
SAAS_STUDIO_MONTHLY_PRICE_CENTS=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASS=local
EMAIL_FROM_NAME=Therapist Platform Local
EMAIL_FROM_ADDRESS=noreply@therapist-platform.local
CONTACT_EMAIL=contato@therapist-platform.local

SENTRY_DSN=
