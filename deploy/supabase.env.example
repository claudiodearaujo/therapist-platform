# Additional values for deploy/docker-compose.supabase.yml, after approved cutover.
# Keep local stack variables and POSTGRES_PASSWORD for the retained database.
DATABASE_URL=postgresql://prisma:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# Migration role owns the application tables. Direct or session pooling (5432), never transaction pooling.
DIRECT_URL=postgresql://prisma:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_STORAGE_BUCKET=therapist-platform
SUPABASE_PRIVATE_STORAGE_BUCKET=therapist-private
