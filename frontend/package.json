{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.32",
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/forms": "20.3.32",
    "@angular/platform-browser": "20.3.32",
    "@angular/router": "20.3.32",
    "@angular/service-worker": "20.3.32",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@playwright/test": "^1.57.0",
    "@primeuix/themes": "^2.0.2",
    "@sentry/angular": "^10.40.0",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "chart.js": "^4.5.1",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "quill": "2.0.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.6",
    "@angular/cli": "^20.3.17",
    "@angular/compiler-cli": "20.3.32",
    "typescript": "~5.8.2",
    "vitest": "4.1.11",
    "jsdom": "26.1.0"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "$vitest"
    }
  }
